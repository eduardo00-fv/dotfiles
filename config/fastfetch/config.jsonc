// fastfetch "forja" — paleta Tinta, logo: casco + THRAIN (forja.py lo anima al abrir terminal)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "38;2;224;85;31",
            "2": "38;2;191;174;144",
            "3": "38;2;147;163;90",
            "4": "38;2;94;82;69",
            "5": "38;2;107;123;63",
            "6": "38;2;232;191;106",
            "7": "38;2;217;164;65",
            "8": "38;2;232;116;74",
            "9": "38;2;201;70;27"
        },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;224;85;31", "title": "38;2;236;220;192", "separator": "38;2;94;82;69" },
        "key": { "width": 13 }
    },
    "modules": [
        { "type": "custom", "format": "\u001b[38;2;147;163;90mla forja\u001b[38;2;94;82;69m  ·  arch + hyprland" },
        { "type": "custom", "format": "\u001b[38;2;94;82;69m──────────────────────────────────" },
        { "type": "os",       "key": "󰣇  sistema", "format": "{name}" },
        { "type": "kernel",   "key": "\uf17c  kernel" },
        { "type": "wm",       "key": "\uf2d2  hypr",   "format": "{pretty-name} {version}" },
        { "type": "command",  "key": "\uf489  shell", "text": "echo zsh $(zsh -c 'echo $ZSH_VERSION')" },   // forja.py es el padre de fastfetch
        { "type": "terminal", "key": "\ue795  term" },
        { "type": "packages", "key": "󰏖  paquetes", "format": "{pacman} pacman · {flatpak-user} flatpak" },
        { "type": "custom", "format": "\u001b[38;2;94;82;69m──────────────────────────────────" },
        { "type": "cpu",      "key": "󰻠  cpu",    "keyColor": "38;2;217;164;65", "format": "{name}" },
        { "type": "gpu",      "key": "󰢮  gpu",    "keyColor": "38;2;217;164;65", "format": "{name}" },
        { "type": "memory",   "key": "󰍛  ram",    "keyColor": "38;2;217;164;65" },
        { "type": "disk",     "key": "󰋊  disco",  "keyColor": "38;2;217;164;65", "folders": "/" },
        { "type": "battery",  "key": "󰁹  batería", "keyColor": "38;2;217;164;65" },
        { "type": "uptime",   "key": "󰔟  en pie",  "keyColor": "38;2;217;164;65" },
        { "type": "custom", "format": "\u001b[38;2;94;82;69m──────────────────────────────────" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
