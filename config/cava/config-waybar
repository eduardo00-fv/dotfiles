# cava para la waybar: 12 barras en texto crudo, las pinta scripts/cava.sh
[general]
bars = 12
framerate = 30
sleep_timer = 2

[input]
method = pipewire

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
noise_reduction = 70
