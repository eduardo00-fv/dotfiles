#!/bin/bash
# Abre/cierra la tarjeta de calendario de eww en el monitor enfocado
if eww active-windows | grep -q '^calendario'; then
    eww close calendario
else
    modelo=$(hyprctl monitors -j | python3 -c "import sys,json; print(next(m['model'] for m in json.load(sys.stdin) if m['focused']))")
    eww open calendario --screen "$modelo"
fi
