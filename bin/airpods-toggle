#!/usr/bin/env bash
# Conecta/desconecta los AirPods (clic en el módulo bluetooth de la waybar).
# La MAC va en ~/.config/airpods-mac (una línea), fuera del repo de dotfiles.
# Para verla: bluetoothctl devices
MAC=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/airpods-mac" 2>/dev/null)
[ -z "$MAC" ] && { notify-send -a Bluetooth "Falta ~/.config/airpods-mac" "Pon ahí la MAC de tus audífonos (bluetoothctl devices)"; exit 1; }
if bluetoothctl info "$MAC" | grep -q 'Connected: yes'; then
    bluetoothctl disconnect "$MAC" >/dev/null && notify-send -a Bluetooth "AirPods desconectados"
else
    rfkill unblock bluetooth; bluetoothctl power on >/dev/null
    if bluetoothctl connect "$MAC" >/dev/null 2>&1; then
        notify-send -a Bluetooth "AirPods conectados"
    else
        notify-send -a Bluetooth -u critical "No se pudieron conectar los AirPods" "¿Están fuera del estuche? Si dice br-connection-key-missing, hay que re-emparejarlos."
    fi
fi
